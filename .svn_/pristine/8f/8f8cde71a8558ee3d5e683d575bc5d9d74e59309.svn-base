package ${packageName}.domain;

    #foreach ($import in $importList)
    import ${import};
    #end
import org.apache.commons.lang3.builder.ToStringBuilder;
import org.apache.commons.lang3.builder.ToStringStyle;
import com.szmtr.common.core.web.domain.CommonEntity;
import com.szmtr.common.core.annotation.Excel;
    #if($table.crud || $table.sub)
    import com.szmtr.common.core.web.domain.BaseEntity;
    #elseif($table.tree)
    import com.szmtr.common.core.web.domain.TreeEntity;
    #end
    ## ---------- 新增关键导入 ----------
import com.fasterxml.jackson.annotation.JsonFormat;
import org.springframework.format.annotation.DateTimeFormat;
import com.baomidou.mybatisplus.annotation.TableField;
import com.baomidou.mybatisplus.annotation.TableId;
import com.baomidou.mybatisplus.annotation.TableName;
import lombok.Data;

import java.io.Serializable;
import java.time.LocalDate;
import java.time.LocalDateTime;


@TableName("${tableName}")
@Data
public class ${ClassName} extends CommonEntity implements Serializable{
private static final long serialVersionUID=1L;

#foreach ($column in $columns)
    ## ---------- 过滤基类已存在的字段 ----------
    #if(!$column.isSuperColumn())
        ## ---------- 主键处理 ----------
        #if($column.isPk())
            ## 强制使用转换后的javaField小写形式
        private ${column.javaType} ${column.javaField};
        #else
            ## ---------- 逻辑删除字段处理 ----------
            #if($column.javaField == "delFlag")
            @TableLogic
            private Integer delFlag;
            #else
                ## ---------- 普通字段注释 ----------
                #if($column.columnComment != '')
                /** ${column.columnComment} */
                #end
                ## ---------- 日期字段处理 ----------
                #if($column.javaType == 'LocalDateTime')
                @JsonFormat(pattern = "yyyy-MM-dd HH:mm:ss")
                @DateTimeFormat(pattern = "yyyy-MM-dd HH:mm:ss")
                private LocalDateTime ${column.javaField};
                #elseif($column.javaType == 'Date')
                @JsonFormat(pattern = "yyyy-MM-dd")
                @DateTimeFormat(pattern = "yyyy-MM-dd")
                private LocalDate ${column.javaField};
                #else
                    ## 强制使用转换后的javaField小写形式
                private ${column.javaType} ${column.javaField};
                #end


            #end
        #end
    #end
#end
}