    /**
     * 获取路由信息
     *
     * @return 路由信息
     */
    @GetMapping("getRouters")
    public AjaxResult getRouters() {
        List<SysMenu> menus = new ArrayList<>();//menuService.selectMenuTreeByUserId(uId);
        //系统管理
        SysMenu sysManagerMenu = new SysMenu();
        sysManagerMenu.setMenuId(1L);
        sysManagerMenu.setMenuName("系统管理");
        sysManagerMenu.setParentId(0l);
        sysManagerMenu.setOrderNum(1);
        sysManagerMenu.setPath("system");
        sysManagerMenu.setIsFrame("1");
        sysManagerMenu.setIsCache("0");
        sysManagerMenu.setMenuType("M");
        sysManagerMenu.setVisible("0");
        sysManagerMenu.setStatus("0");
        sysManagerMenu.setIcon("system");
        menus.add(sysManagerMenu);
        //编码体系
        SysMenu codeSystem = new SysMenu();
        codeSystem.setMenuId(2004L);
        codeSystem.setMenuName("编码体系");
        codeSystem.setParentId(0l);
        codeSystem.setOrderNum(1);
        codeSystem.setPath("codeSystem");
        codeSystem.setIsFrame("1");
        codeSystem.setIsCache("0");
        codeSystem.setMenuType("M");
        codeSystem.setVisible("0");
        codeSystem.setStatus("0");
        codeSystem.setIcon("cascader");
        menus.add(codeSystem);

//        授权管理
        SysMenu authMenu = new SysMenu();
        authMenu.setMenuId(101L);
        authMenu.setMenuName("权限组定义");
        authMenu.setParentId(1l);
        authMenu.setOrderNum(1);
        authMenu.setComponent("system/role/index");
        authMenu.setMenuType("C");
        authMenu.setPath("role");
        authMenu.setIsFrame("1");
        authMenu.setIsCache("0");
        authMenu.setMenuType("C");
        authMenu.setVisible("0");
        authMenu.setStatus("0");
        authMenu.setIcon("peoples");
        menus.add(authMenu);
        //菜单管理
        SysMenu menu = new SysMenu();
        menu.setMenuId(102L);
        menu.setMenuName("菜单定义");
        menu.setParentId(1l);
        menu.setOrderNum(3);
        menu.setComponent("system/menu/index");
        menu.setMenuType("C");
        menu.setPath("menu");
        menu.setIsFrame("1");
        menu.setIsCache("0");
        menu.setMenuType("C");
        menu.setVisible("0");
        menu.setStatus("0");
        menu.setIcon("peoples");
        menus.add(menu);
        //编码体系管理
        SysMenu codeSystemManager = new SysMenu();
        codeSystemManager.setMenuId(2005L);
        codeSystemManager.setMenuName("编码体系");
        codeSystemManager.setParentId(2004l);
        codeSystemManager.setOrderNum(3);
        codeSystemManager.setComponent("business/rdscodetype/index");
        codeSystemManager.setMenuType("C");
        codeSystemManager.setPath("codeSystem");
        codeSystemManager.setIsFrame("1");
        codeSystemManager.setIsCache("0");
        codeSystemManager.setMenuType("C");
        codeSystemManager.setVisible("0");
        codeSystemManager.setStatus("0");
        codeSystemManager.setIcon("code");
        codeSystemManager.setRouteName("编码体系");
        menus.add(codeSystemManager);
        List<SysMenu> menusList = menuService.selectMenuTreeByUserId(menus);
        return success(menuService.buildMenus(menusList));
    }
}