spring:
    # redis 配置
    redis:
            # 地址
        host: 127.0.0.1
            # 端口，默认为6379
        port: 6379
            # 数据库索引
        database: 1
            # 密码
        password:
            # 连接超时时间
        timeout: 100s
        lettuce:
            pool:
                    # 连接池中的最小空闲连接
                min-idle: 0
                    # 连接池中的最大空闲连接
                max-idle: 8
                    # 连接池的最大数据库连接数
                max-active: 8

    rabbitmq:
        host: localhost
        port: 5672
        username: guest
        password: guest
        # 使用 JSON 序列化消息（可选）
        template:
            exchange: fanout.exchange
        listener:
            simple:
                acknowledge-mode: manual  # 手动确认消息（可选）
        queueName: queueA    #队列
        switchName: fanout.exchange  #交换机的交换通道
        routingKey:

    cloud:
        nacos:
            discovery:
                # 服务注册地址
                server-addr: 127.0.0.1:8848
                username: nacos  # 显式指定用户名密码
                password: nacos
            config:
                # 配置中心地址
                server-addr: 127.0.0.1:8848
                username: nacos  # 显式指定用户名密码
                password: nacos
                refresh-enabled: true
    main:
        allow-bean-definition-overriding: true

